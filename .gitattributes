# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force specific files to LF (shell scripts must strictly be LF)
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source code
*.py text diff=python eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.css text eol=lf
*.sql text eol=lf

# Lockfiles - do not treat as binary, but suppress generated diffs where possible
requirements.lock -diff
web/package-lock.json -diff

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.node binary
*.wasm binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.tar.gz binary
*.tgz binary
*.zip binary
*.tzst binary
