# Copy and replace secret values, or run python scripts/configure.py.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./aegis.db
REDIS_URL=
OPENSEARCH_URL=
AUDIT_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
POSTGRES_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_MAINTENANCE_PASSWORD=
REDIS_PASSWORD=
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_USERNAME=aegis
OPENSEARCH_PASSWORD=
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
AI_PROVIDER=local
AI_API_KEY=
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4.1-mini
AI_MAX_TOKENS=1500
MAX_EVENT_BYTES=65536
MAX_BATCH_EVENTS=500
MAX_SEARCH_DAYS=31
RETENTION_DAYS=90
RETENTION_BATCH_SIZE=500
RETENTION_INTERVAL_SECONDS=3600
DETECTION_LATENESS_SECONDS=120
INTEGRATION_ALLOWED_HOSTS=[]
AEGIS_INTEGRATION_SOC_WEBHOOK=
AEGIS_INTEGRATION_IOC_FEED=
# Automated retention is enabled via aegis-retention service and respects legal holds.

# Intelligence providers are optional. Never commit a real API key.
INTEL_AUTO_PROVIDER=none
INTEL_MOCK_ENABLED=false
INTEL_VT_ENABLED=false
INTEL_VT_API_KEY=
INTEL_CACHE_SECONDS=3600
INTEL_FAILURE_CACHE_SECONDS=300
INTEL_REFRESH_SECONDS=60
INTEL_REQUESTS_PER_MINUTE=4
INTEL_QUEUE_CAPACITY=500
INTEL_TIMEOUT_SECONDS=5
